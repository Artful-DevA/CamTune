[Desktop Entry]
Type=Application
Name=CamTune
GenericName=Webcam Controls
Comment=Webcam controls, framing and a low-latency virtual camera for video calls
Exec=camtune
Icon=io.github.CamTune
Terminal=false
Categories=AudioVideo;Video;Utility;
Keywords=webcam;camera;v4l2;virtual camera;zoom;video call;
StartupNotify=true
SingleMainWindow=true
Actions=Normal;CloseUp;ToggleVirtualCamera;

[Desktop Action Normal]
Name=Preset 1
Exec=camtune --preset 1

[Desktop Action CloseUp]
Name=Preset 3
Exec=camtune --preset 3

[Desktop Action ToggleVirtualCamera]
Name=Toggle virtual camera
Exec=camtune --virtual-camera toggle
